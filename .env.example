# Development only: copy to .env. Keep production secrets in Render, not files.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/db_next_workshop_pos?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/db_next_workshop_pos?schema=public
SECRET_KEY=
QR_TOKEN_SECRET=
CORS_ORIGINS=http://localhost:3000
# Optional server-only compatibility flag; keep enabled for the current Counter flow.
ORD02_COUNTER_CHECKOUT_ENABLED=true
# Render production: NODE_ENV=production, PORT is supplied by Render.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=5&pool_timeout=20&connect_timeout=15
# DIRECT_URL=postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
# CORS_ORIGINS=https://your-pos.vercel.app
# SECRET_KEY: unique random secret of at least 32 bytes.
# QR_TOKEN_SECRET: independent 32-byte secret encoded as 64 hex characters.
# Upload storage remains ./uploads; mount a Render persistent disk there.
# No receipt environment variable is required; Kanit fonts are tracked in this repository.
# Offline first-admin provisioning only; never persist these in Render service environment.
# FIRST_ADMIN_EXPECTED_DATABASE=neondb
# FIRST_ADMIN_EXPECTED_HOST=ep-EXAMPLE-pooler.REGION.aws.neon.tech
# FIRST_ADMIN_NAME=
# FIRST_ADMIN_USERNAME=
# FIRST_ADMIN_PASSWORD=
# npm run admin:first is read-only; npm run admin:first -- --apply requires an empty User table.
