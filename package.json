{
  "name": "next-pos-api",
  "version": "2.0.1",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/prisma-deploy.js generate",
    "db:validate": "node scripts/prisma-deploy.js validate",
    "db:migrate:deploy": "node scripts/prisma-deploy.js deploy",
    "db:migrate:status": "node scripts/prisma-deploy.js status",
    "test:config": "node --test test/deployment-config.test.js",
    "test:catalog-cache": "node --require ./test/bootstrap.js --test test/catalog-cache.test.js",
    "test:receipt": "node --test test/receipt-pdf.test.js",
    "test:vat": "node --require ./test/bootstrap.js --test --test-concurrency=1 test/vat.test.js test/vat-workflows.test.js test/receipt-pdf.test.js",
    "test:benchmark": "node --test test/benchmark-core.test.js test/benchmark-financials.test.js",
    "benchmark:local": "node test/performance-benchmark.js",
    "test:migration": "node --require ./test/bootstrap.js --test --test-concurrency=1 test/cart-food-constraint.test.js test/first-admin.test.js test/kassa-role-migration.test.js test/money-cents-migration.test.js",
    "admin:first": "node scripts/create-first-admin.js",
    "test": "node --require ./test/bootstrap.js --test --test-concurrency=1 test/auth.test.js test/kassa-role.test.js test/cart.test.js test/checkout.test.js test/order-domain.test.js test/order-policy.test.js test/order-refunds.test.js test/tables.test.js test/qr-public.test.js test/service-calls.test.js test/staff-orders.test.js test/waiter-orders.test.js test/kitchen-orders.test.js test/table-payment.test.js test/user.test.js test/food.test.js test/food-type.test.js test/food-size.test.js test/taste.test.js test/organization.test.js test/bill-sale.test.js test/report.test.js test/image-upload.test.js test/upload-boundary.test.js test/image-variants.test.js test/catalog-cache.test.js test/post-save-cleanup.test.js test/food-validation.test.js test/money.test.js test/money-workflows.test.js test/vat.test.js test/vat-workflows.test.js test/receipt-pdf.test.js test/receipt-identity.test.js test/tax-draft.test.js test/tax-policy.test.js test/commercial-vat.test.js test/tax-publication-readiness.test.js test/tax-approval.test.js test/tax-control.test.js",
    "test:db:prepare": "node scripts/prepare-test-database.js",
    "test:db:validate": "node --require ./test/bootstrap.js node_modules/prisma/build/index.js validate",
    "migrate:passwords": "node scripts/migrate-passwords.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:receipt-identity": "node --require ./test/bootstrap.js --test test/receipt-identity.test.js",
    "test:tax-draft": "node --require ./test/bootstrap.js --test test/tax-draft.test.js",
    "test:tax-policy": "node --require ./test/bootstrap.js --test test/tax-policy.test.js",
    "test:commercial-vat": "node --test test/commercial-vat.test.js",
    "test:tax-publication-readiness": "node --require ./test/bootstrap.js --test test/tax-publication-readiness.test.js",
    "test:tax-approval": "node --require ./test/bootstrap.js --test test/tax-approval.test.js",
    "test:tax-control": "node --require ./test/bootstrap.js --test --test-concurrency=1 test/tax-control.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "body-parser": "^2.3.0",
    "busboy": "1.6.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prisma": "^5.22.0"
  }
}
