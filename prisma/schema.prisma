// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                  @id() @default(autoincrement())
  name                     String
  username                 String
  password                 String
  level                    String               @default("admin")
  status                   String               @default("use")
  BillSale                 BillSale[]
  CancelledBills           BillSale[]           @relation("BillCancelledBy")
  SaleTemp                 SaleTemp[]
  CreatedOrders            Order[]              @relation("OrderCreatedBy")
  OrderStatusHistories     OrderStatusHistory[] @relation("OrderStatusActor")
  AcknowledgedServiceCalls ServiceCall[]        @relation("ServiceCallAcknowledgedBy")
  ResolvedServiceCalls     ServiceCall[]        @relation("ServiceCallResolvedBy")
}

model FoodType {
  id        Int        @id() @default(autoincrement())
  name      String
  remark    String
  status    String     @default("use")
  foodSizes FoodSize[]
  tastes    Taste[]
  food      Food[]
}

model FoodSize {
  id                 Int                 @id() @default(autoincrement())
  name               String
  remark             String
  foodTypeId         Int
  moneyAdded         Int
  status             String              @default("use")
  FoodType           FoodType            @relation(fields: [foodTypeId], references: [id])
  saleTempDetails    SaleTempDetail[]
  billSaleDetails    BillSaleDetail[]
  orderItemModifiers OrderItemModifier[]
}

model Taste {
  id                 Int                 @id() @default(autoincrement())
  name               String
  remark             String
  status             String              @default("use")
  foodTypeId         Int
  FoodType           FoodType            @relation(fields: [foodTypeId], references: [id])
  saleTempDetails    SaleTempDetail[]
  billSaleDetails    BillSaleDetail[]
  orderItemModifiers OrderItemModifier[]
}

model Food {
  id              Int              @id() @default(autoincrement())
  name            String
  img             String
  detailImg       String           @default("")
  remark          String
  status          String           @default("use")
  price           Int
  foodTypeId      Int
  foodType        String           @default("food")
  FoodType        FoodType         @relation(fields: [foodTypeId], references: [id])
  SaleTempDetails SaleTempDetail[]
  SaleTemps       SaleTemp[]
  BillSaleDetail  BillSaleDetail[]
  OrderItems      OrderItem[]
}

model SaleTemp {
  id              Int              @id() @default(autoincrement())
  userId          Int
  tableNo         Int
  foodId          Int
  qty             Int              @default(1)
  saleTempDetails SaleTempDetail[]
  Food            Food             @relation(fields: [foodId], references: [id])
  User            User             @relation(fields: [userId], references: [id])

  @@unique([userId, tableNo, foodId])
}

model SaleTempDetail {
  id         Int       @id() @default(autoincrement())
  saleTempId Int
  foodId     Int
  tasteId    Int?
  foodSizeId Int?
  Food       Food      @relation(fields: [foodId], references: [id])
  Taste      Taste?    @relation(fields: [tasteId], references: [id])
  FoodSize   FoodSize? @relation(fields: [foodSizeId], references: [id])
  SaleTemp   SaleTemp  @relation(fields: [saleTempId], references: [id])
}

model Organization {
  id      Int    @id() @default(autoincrement())
  name    String
  phone   String
  address String
  email   String
  website String
  bankNo  String
  logo    String
  taxCode String
}

model BillSale {
  id                  Int              @id() @default(autoincrement())
  createdDate         DateTime         @default(now())
  amount              Int
  payType             String
  payDate             DateTime         @default(now())
  userId              Int
  inputMoney          Int
  returnMoney         Int
  tableNo             Int?
  serviceType         ServiceType      @default(DINE_IN)
  status              String           @default("use")
  idempotencyKey      String?
  checkoutFingerprint String?
  cancelledAt         DateTime?
  cancelledByUserId   Int?
  cancelReason        String?
  tableSessionId      Int?             @unique
  User                User             @relation(fields: [userId], references: [id])
  CancelledBy         User?            @relation("BillCancelledBy", fields: [cancelledByUserId], references: [id])
  BillSaleDetails     BillSaleDetail[]
  TableSession        TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  Orders              Order[]

  @@unique([userId, idempotencyKey])
  @@index([payDate, status])
}

model BillSaleDetail {
  id           Int       @id() @default(autoincrement())
  billSaleId   Int
  foodId       Int
  foodSizeId   Int?
  tastedId     Int?
  moneyAdded   Int       @default(0)
  price        Int
  foodName     String
  foodSizeName String?
  tasteName    String?
  BillSale     BillSale  @relation(fields: [billSaleId], references: [id])
  Food         Food      @relation(fields: [foodId], references: [id])
  FoodSize     FoodSize? @relation(fields: [foodSizeId], references: [id])
  Taste        Taste?    @relation(fields: [tastedId], references: [id])
}

enum OrderChannel {
  COUNTER
  QR
  STAFF
}

enum ServiceType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
  PREPARING
  READY
  SERVED
  PAID
  COMPLETED
  CANCELLED
}

enum OrderModifierType {
  SIZE
  TASTE
}

enum OrderActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum ServiceCallStatus {
  REQUESTED
  ACKNOWLEDGED
  RESOLVED
}

enum QrMode {
  DISABLED
  MENU_ONLY
  ORDERING
}

model QrPolicy {
  id        Int      @id
  mode      QrMode   @default(DISABLED)
  updatedAt DateTime @updatedAt
}

model RestaurantTable {
  id        Int            @id() @default(autoincrement())
  tableNo   Int            @unique
  name      String?
  status    String         @default("use")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  Sessions  TableSession[]
  Orders    Order[]
}

model TableSession {
  id                Int                @id() @default(autoincrement())
  restaurantTableId Int
  status            TableSessionStatus @default(OPEN)
  qrTokenHash       String?            @unique
  qrTokenNonce      String?
  qrTokenExpiresAt  DateTime?
  tokenVersion      Int                @default(0)
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  RestaurantTable   RestaurantTable    @relation(fields: [restaurantTableId], references: [id], onDelete: Restrict)
  Orders            Order[]
  BillSale          BillSale?
  ServiceCalls      ServiceCall[]

  // EN: PostgreSQL enforces one OPEN session per table with a partial unique index in the migration.
  // FI: PostgreSQL varmistaa migraation osittaisella yksilöllisellä indeksillä yhden OPEN-istunnon pöytää kohden.
  @@index([restaurantTableId, status])
  @@index([status, openedAt])
}

model ServiceCall {
  id                   Int               @id() @default(autoincrement())
  tableSessionId       Int
  status               ServiceCallStatus @default(REQUESTED)
  version              Int               @default(1)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  acknowledgedByUserId Int?
  resolvedByUserId     Int?
  TableSession         TableSession      @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  AcknowledgedBy       User?             @relation("ServiceCallAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  ResolvedBy           User?             @relation("ServiceCallResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  // EN: A partial unique index in the migration allows only one unresolved call per table session.
  // FI: Migraation osittainen yksilöllinen indeksi sallii vain yhden keskeneräisen kutsun pöytäistuntoa kohden.
  @@index([status, createdAt])
  @@index([tableSessionId, createdAt])
}

model Order {
  id                     Int                  @id() @default(autoincrement())
  channel                OrderChannel
  status                 OrderStatus          @default(SUBMITTED)
  restaurantTableId      Int?
  tableSessionId         Int?
  tableNo                Int?
  serviceType            ServiceType          @default(DINE_IN)
  createdByUserId        Int?
  subtotal               Int
  modifierTotal          Int
  total                  Int
  version                Int                  @default(1)
  idempotencyScope       String
  idempotencyKey         String
  idempotencyFingerprint String
  submittedAt            DateTime             @default(now())
  confirmedAt            DateTime?
  rejectedAt             DateTime?
  preparingAt            DateTime?
  readyAt                DateTime?
  servedAt               DateTime?
  paidAt                 DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  rejectionReason        String?
  cancellationReason     String?
  billSaleId             Int?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  RestaurantTable        RestaurantTable?     @relation(fields: [restaurantTableId], references: [id], onDelete: Restrict)
  TableSession           TableSession?        @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  CreatedBy              User?                @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  BillSale               BillSale?            @relation(fields: [billSaleId], references: [id], onDelete: Restrict)
  Items                  OrderItem[]
  StatusHistory          OrderStatusHistory[]

  @@unique([idempotencyScope, idempotencyKey])
  @@index([status, updatedAt])
  @@index([updatedAt, id])
  @@index([channel, status, createdAt])
  @@index([tableSessionId, status, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([billSaleId])
}

model OrderItem {
  id                Int                 @id() @default(autoincrement())
  orderId           Int
  foodId            Int
  foodName          String
  quantity          Int
  unitBasePrice     Int
  unitModifierTotal Int
  unitTotal         Int
  lineTotal         Int
  note              String?
  Order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Food              Food                @relation(fields: [foodId], references: [id], onDelete: Restrict)
  Modifiers         OrderItemModifier[]

  @@index([orderId])
  @@index([foodId])
}

model OrderItemModifier {
  id              Int               @id() @default(autoincrement())
  orderItemId     Int
  type            OrderModifierType
  foodSizeId      Int?
  tasteId         Int?
  name            String
  priceAdjustment Int
  OrderItem       OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  FoodSize        FoodSize?         @relation(fields: [foodSizeId], references: [id], onDelete: SetNull)
  Taste           Taste?            @relation(fields: [tasteId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([foodSizeId])
  @@index([tasteId])
}

model OrderStatusHistory {
  id          Int            @id() @default(autoincrement())
  orderId     Int
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  version     Int
  actorType   OrderActorType
  actorUserId Int?
  reason      String?
  createdAt   DateTime       @default(now())
  Order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ActorUser   User?          @relation("OrderStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([orderId, version])
  @@index([orderId, createdAt])
}
